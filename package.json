{
  "name": "ag-show-session-id",
  "displayName": "Recent Copilot Chat ID",
  "description": "Shows the most recently saved local Copilot Chat session ID without reading chat content.",
  "version": "0.1.0",
  "preview": true,
  "publisher": "yamapan",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aktsmm/vscode-recent-copilot-chat-id"
  },
  "bugs": {
    "url": "https://github.com/aktsmm/vscode-recent-copilot-chat-id/issues"
  },
  "homepage": "https://github.com/aktsmm/vscode-recent-copilot-chat-id#readme",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "chat",
    "session"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "agShowSessionId.refresh",
        "category": "%command.category%",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "agShowSessionId.copyRecent",
        "category": "%command.category%",
        "title": "%command.copyRecent.title%",
        "icon": "$(copy)"
      },
      {
        "command": "agShowSessionId.showSessions",
        "category": "%command.category%",
        "title": "%command.showSessions.title%",
        "icon": "$(search)"
      },
      {
        "command": "agShowSessionId.showOutput",
        "category": "%command.category%",
        "title": "%command.showOutput.title%",
        "icon": "$(output)"
      },
      {
        "command": "agShowSessionId.openView",
        "category": "%command.category%",
        "title": "%command.openView.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "agShowSessionId.copySession",
        "category": "%command.category%",
        "title": "%command.copySession.title%",
        "icon": "$(copy)"
      },
      {
        "command": "agShowSessionId.showDetails",
        "category": "%command.category%",
        "title": "%command.showDetails.title%",
        "icon": "$(inspect)"
      },
      {
        "command": "agShowSessionId.setAlias",
        "category": "%command.category%",
        "title": "%command.setAlias.title%",
        "icon": "$(edit)"
      },
      {
        "command": "agShowSessionId.clearAlias",
        "category": "%command.category%",
        "title": "%command.clearAlias.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "agShowSessionId.openSettings",
        "category": "%command.category%",
        "title": "%command.openSettings.title%",
        "icon": "$(gear)"
      },
      {
        "command": "agShowSessionId.enable",
        "category": "%command.category%",
        "title": "%command.enable.title%"
      },
      {
        "command": "agShowSessionId.enableTitles",
        "category": "%command.category%",
        "title": "%command.enableTitles.title%",
        "icon": "$(eye)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agShowSessionIdSessions",
          "title": "%view.container.title%",
          "icon": "images/sessions-activity.svg"
        }
      ]
    },
    "views": {
      "agShowSessionIdSessions": [
        {
          "id": "agShowSessionId.sessionsView",
          "name": "%view.sessions.name%",
          "contextualTitle": "%view.container.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agShowSessionId.sessionsView",
        "contents": "%view.welcome.disabled%",
        "when": "!config.agShowSessionId.enabled"
      },
      {
        "view": "agShowSessionId.sessionsView",
        "contents": "%view.welcome.empty%",
        "when": "config.agShowSessionId.enabled && agShowSessionId.scanAvailable && !agShowSessionId.hasSessions"
      },
      {
        "view": "agShowSessionId.sessionsView",
        "contents": "%view.welcome.unavailable%",
        "when": "config.agShowSessionId.enabled && !agShowSessionId.scanAvailable"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agShowSessionId.refresh",
          "when": "view == agShowSessionId.sessionsView",
          "group": "navigation@1"
        },
        {
          "command": "agShowSessionId.showSessions",
          "when": "view == agShowSessionId.sessionsView",
          "group": "navigation@2"
        },
        {
          "command": "agShowSessionId.enableTitles",
          "when": "view == agShowSessionId.sessionsView && config.agShowSessionId.enabled && !config.agShowSessionId.readTitles",
          "group": "navigation@3"
        },
        {
          "command": "agShowSessionId.openSettings",
          "when": "view == agShowSessionId.sessionsView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "agShowSessionId.copySession",
          "when": "view == agShowSessionId.sessionsView && (viewItem == chatSession || viewItem == chatSessionWithAlias)",
          "group": "inline@1"
        },
        {
          "command": "agShowSessionId.setAlias",
          "when": "view == agShowSessionId.sessionsView && (viewItem == chatSession || viewItem == chatSessionWithAlias)",
          "group": "1_edit@1"
        },
        {
          "command": "agShowSessionId.showDetails",
          "when": "view == agShowSessionId.sessionsView && (viewItem == chatSession || viewItem == chatSessionWithAlias)",
          "group": "navigation@2"
        },
        {
          "command": "agShowSessionId.clearAlias",
          "when": "view == agShowSessionId.sessionsView && viewItem == chatSessionWithAlias",
          "group": "1_edit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agShowSessionId.copySession",
          "when": "false"
        },
        {
          "command": "agShowSessionId.enable",
          "when": "false"
        },
        {
          "command": "agShowSessionId.clearAlias",
          "when": "false"
        },
        {
          "command": "agShowSessionId.showDetails",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "agShowSessionId.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%configuration.enabled.description%"
        },
        "agShowSessionId.readTitles": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%configuration.readTitles.description%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "icon": "node scripts/generate-icon.mjs",
    "precompile": "npm run clean",
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "test": "npm run test:unit && npm run test:extension",
    "pretest:unit": "npm run compile",
    "test:unit": "node --test out/test/session-scanner.test.js out/test/session-index.test.js out/test/session-model.test.js out/test/session-alias-store.test.js out/test/session-tree-model.test.js out/test/visible-refresh.test.js out/test/status-presentation.test.js out/test/copy-session.test.js out/test/localization.test.js out/test/manifest.test.js",
    "pretest:extension": "npm run compile",
    "test:extension": "node out/test/run-test.js",
    "prepackage": "npm run icon",
    "package": "npm run compile && node scripts/package-extension.mjs && npm run verify:vsix",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:release": "npm audit --audit-level=high && npm test && npm run package && npm run verify:install"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.9.2"
  }
}
